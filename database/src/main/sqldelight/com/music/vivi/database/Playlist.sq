upsert:
INSERT OR IGNORE INTO playlist(
  id, title, author, thumbnail, description,
  song_count, total_duration_sec, source, browse_id, updated_ms
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT * FROM playlist WHERE id = ?;

selectAll:
SELECT * FROM playlist ORDER BY updated_ms DESC;

selectBySource:
SELECT * FROM playlist WHERE source = ? ORDER BY updated_ms DESC;

updateMetadata:
UPDATE playlist SET title = ?, author = ?, thumbnail = ?, description = ?, song_count = ?,
 total_duration_sec = ?, source = ?, browse_id = ?, updated_ms = ? WHERE id = ?;

deleteById:
DELETE FROM playlist WHERE id = ?;

setTitle:
UPDATE playlist SET title = ?, updated_ms = ? WHERE id = ?;

setStats:
UPDATE playlist SET song_count = ?, total_duration_sec = ?, thumbnail = COALESCE(?, thumbnail), updated_ms = ? WHERE id = ?;
