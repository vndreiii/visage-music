clearForPlaylist:
DELETE FROM playlist_song WHERE playlist_id = ?;

upsert:
INSERT OR REPLACE INTO playlist_song(playlist_id, song_id, position)
VALUES (?, ?, ?);

songsForPlaylist:
SELECT song.*
FROM playlist_song
JOIN song ON song.id = playlist_song.song_id
WHERE playlist_song.playlist_id = ?
ORDER BY playlist_song.position ASC;

countForPlaylist:
SELECT COUNT(*) AS cnt FROM playlist_song WHERE playlist_id = ?;

removeSong:
DELETE FROM playlist_song WHERE playlist_id = ? AND song_id = ?;

nextPosition:
SELECT COALESCE(MAX(position) + 1, 0) AS next FROM playlist_song WHERE playlist_id = ?;

containsSong:
SELECT COUNT(*) FROM playlist_song WHERE playlist_id = ? AND song_id = ?;

setPosition:
UPDATE playlist_song SET position = ? WHERE playlist_id = ? AND song_id = ?;
