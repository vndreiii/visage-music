CREATE TABLE song (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  artists TEXT NOT NULL DEFAULT '',
  album TEXT,
  duration_sec INTEGER,
  thumbnail TEXT,
  liked INTEGER NOT NULL DEFAULT 0,
  in_library INTEGER NOT NULL DEFAULT 0,
  source TEXT NOT NULL DEFAULT 'youtube',
  local_path TEXT,
  last_seen_ms INTEGER NOT NULL
);

CREATE TABLE playlist (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  author TEXT,
  thumbnail TEXT,
  description TEXT,
  song_count INTEGER,
  total_duration_sec INTEGER,
  source TEXT NOT NULL DEFAULT 'youtube',
  browse_id TEXT,
  updated_ms INTEGER NOT NULL
);

CREATE TABLE playlist_song (
  playlist_id TEXT NOT NULL,
  song_id TEXT NOT NULL,
  position INTEGER NOT NULL,
  PRIMARY KEY (playlist_id, song_id),
  FOREIGN KEY (playlist_id) REFERENCES playlist(id) ON DELETE CASCADE,
  FOREIGN KEY (song_id) REFERENCES song(id) ON DELETE CASCADE
);

CREATE INDEX playlist_song_by_playlist ON playlist_song(playlist_id, position);

CREATE TABLE play_event (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  song_id TEXT NOT NULL,
  title TEXT NOT NULL,
  artists TEXT NOT NULL DEFAULT '',
  thumbnail TEXT,
  duration_sec INTEGER,
  played_at_ms INTEGER NOT NULL
);

CREATE INDEX play_event_by_time ON play_event(played_at_ms DESC);
CREATE INDEX play_event_by_song ON play_event(song_id, played_at_ms DESC);
