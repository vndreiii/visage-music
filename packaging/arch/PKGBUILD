# Maintainer: Alex <alex@milfs.party>
#
# Build VIsage from this checkout: cd packaging/arch && makepkg -si
# The file lives here and not in the repository root, because makepkg
# uses <PKGBUILD dir>/src as scratch space.
# Set VISAGE_VERSION (for example 1.2.3) to build a specific version number.
pkgname=visage
pkgver=1.0.2
pkgrel=1
pkgdesc="YouTube Music player for the desktop"
arch=('x86_64' 'aarch64')
url="https://github.com/vndreiii/visage-music"
license=('GPL-3.0-only')
depends=('mpv' 'libxtst' 'libxrender' 'libxi' 'fontconfig' 'hicolor-icon-theme')
makedepends=('jdk21-openjdk' 'rust' 'git' 'desktop-file-utils')
optdepends=(
    'yt-dlp: stream fallback and offline downloads'
    'gnome-keyring: store the account session in the system keyring'
    'xdg-desktop-portal: folder picker'
)
options=('!debug' '!strip')

_root() {
    # The repository this PKGBUILD lives in (packaging/arch -> ../..).
    realpath "$startdir/../.."
}

pkgver() {
    local v="${VISAGE_VERSION:-$pkgver}"
    v="${v#v}"
    echo "${v%%-*}"
}

build() {
    cd "$(_root)"
    export JAVA_HOME=/usr/lib/jvm/java-21-openjdk
    export VISAGE_VERSION="$(pkgver)"
    cargo build --release --locked --manifest-path native/Cargo.toml
    ./gradlew --no-daemon :composeApp:createDistributable
}

package() {
    cd "$(_root)"
    install -d "$pkgdir/opt" "$pkgdir/usr/bin"
    cp -a composeApp/build/compose/binaries/main/app/visage "$pkgdir/opt/visage"
    ln -s /opt/visage/bin/visage "$pkgdir/usr/bin/visage"

    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/visage.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=VIsage
GenericName=Music Player
Comment=YouTube Music player for the desktop
Exec=visage
Icon=visage
Categories=AudioVideo;Audio;Player;
Terminal=false
StartupWMClass=visage
EOF
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "packaging/icons/visage-$size.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/visage.png"
    done
    install -Dm644 packaging/icons/visage.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/visage.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
