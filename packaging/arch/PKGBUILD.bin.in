# Maintainer: Alex <alex@milfs.party>
#
# Installs the prebuilt VIsage release. The release workflow fills in the version and checksums.
pkgname=visage-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="YouTube Music player for the desktop (prebuilt release)"
arch=('x86_64' 'aarch64')
url="https://github.com/vndreiii/visage-music"
license=('GPL-3.0-only')
depends=('mpv' 'libxtst' 'libxrender' 'libxi' 'fontconfig' 'hicolor-icon-theme')
optdepends=(
    'yt-dlp: stream fallback and offline downloads'
    'gnome-keyring: store the account session in the system keyring'
    'xdg-desktop-portal: folder picker'
)
provides=('visage')
conflicts=('visage')
options=('!debug' '!strip')
source_x86_64=("visage-$pkgver-linux-x86_64.tar.gz::$url/releases/download/v$pkgver/visage-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("visage-$pkgver-linux-aarch64.tar.gz::$url/releases/download/v$pkgver/visage-$pkgver-linux-aarch64.tar.gz")
source=("visage.png::https://raw.githubusercontent.com/vndreiii/visage-music/v$pkgver/packaging/icons/visage-256.png")
sha256sums=('SKIP')
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
    install -d "$pkgdir/opt" "$pkgdir/usr/bin"
    cp -a "$srcdir/visage" "$pkgdir/opt/visage"
    ln -s /opt/visage/bin/visage "$pkgdir/usr/bin/visage"
    install -Dm644 "$srcdir/visage.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/visage.png"
    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/visage.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=VIsage
GenericName=Music Player
Comment=YouTube Music player for the desktop
Exec=visage
Icon=visage
Categories=AudioVideo;Audio;Player;
Terminal=false
StartupWMClass=visage
EOF
}
